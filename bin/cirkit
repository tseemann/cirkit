#!/usr/bin/env perl
use 5.32.0;
use strict;
use warnings;
use List::Util qw(min max);
use Getopt::Std;
use File::Basename;
use IO::Uncompress::AnyUncompress qw(anyuncompress $AnyUncompressError);
use Data::Dumper;

#......................................................................................
my $VERSION = "0.0.1";
my $EXE = basename($0);
my $URL = 'https://github.com/tseemann/cirkit';
#......................................................................................
my %opt = (
  'k' => 25,
);
#......................................................................................
sub usage {
  my($errcode) = @_;
  $errcode ||= 0;
  my $ofh = $errcode ? \*STDERR : \*STDOUT;
  print $ofh 
    "NAME\n  $EXE $VERSION\n",
    "SYNOPSIS\n  Trim concatenated plasmids \n",
    "USAGE\n  $EXE [opts] plasmid.fasta[.gz,bz2]\n",
    "OPTIONS\n",
    "  -h       Print this help\n",
    "  -v       Print version and exit\n",
    "  -C       Show citation and exit\n",
    "  -q       No output while running, only errors\n",
    "  -k INT   K-mer size to use [$opt{k}]\n",
    "HOMEPAGE\n  $URL\n",
    "END\n";
  exit($errcode);
}
#......................................................................................
sub version { 
  say "$EXE $VERSION"; 
  exit(0); 
}
#......................................................................................
sub citation {
  say "Seemann T (2026), '$EXE' Github $URL";
  exit(0);
}
#......................................................................................
sub msg { print STDERR "@_\n" unless $opt{'q'}; }
sub wrn { msg("WARNING:", @_); }
sub err { print STDERR "ERROR: @_\n"; exit(-1); }
#......................................................................................
getopts('vhqCk:', \%opt) or exit(-1);
$opt{'v'} and version();
$opt{'C'} and citation();
$opt{'h'} and usage(0);
@ARGV or usage(1);
#......................................................................................
msg("This is $EXE $VERSION");
#msg("Loaded",0+@SIGPEP,"models, max length $SIGMAX");

for my $infile (@ARGV) {
  my $unzip = IO::Uncompress::AnyUncompress->new(
    $infile,
    'MultiStream' => 1,  # in case it's block zipped
    'Transparent'  => 1, # allow non-compressed data 
  ) 
  or err("Can't open: $infile");

  my $seqs = load_fasta($unzip);
  @$seqs or err("No sequences found in: $infile");
  my $have = 0;
  
  for my $seq (@$seqs) {
    msg("Processing:", $seq->[0]);
  }
}
msg("Done.");
exit(0);

#......................................................................................
sub load_fasta {
  my($fh) = @_;
  my @seq;
  while (<$fh>) {
    chomp;
    if (m/^\s*>(\S+)/) {
      push @seq, [ $1, '' ];
    }
    else {
      @seq or err("Error parsing FASTA");
      $seq[-1]->[1] .= uc($_);
    }
  }
  msg("Loaded", 0+@seq, "sequences.");
  return \@seq;
}
#......................................................................................

#......................................................................................
