#!/usr/bin/env perl
use 5.32.0;
use strict;
use warnings;
use List::Util qw(min max);
use Getopt::Std;
use File::Basename;
use IO::Uncompress::AnyUncompress qw(anyuncompress $AnyUncompressError);
use Data::Dumper;

#......................................................................................
my $VERSION = "0.0.2";
my $EXE = basename($0);
my $URL = 'https://github.com/tseemann/cirkit';
#......................................................................................
my %opt = (
  'k' => 25,
);
#......................................................................................
sub usage {
  my($errcode) = @_;
  $errcode ||= 0;
  my $ofh = $errcode ? \*STDERR : \*STDOUT;
  print $ofh 
    "NAME\n  $EXE $VERSION\n",
    "SYNOPSIS\n  Trim concatenated plasmids to single copy \n",
    "USAGE\n  $EXE [opts] contigs.fasta ...\n",
    "OPTIONS\n",
    "  -h       Print this help\n",
    "  -v       Print version and exit\n",
    "  -C       Show citation and exit\n",
    "  -q       No output while running, only errors\n",
    "  -k INT   K-mer size to use [$opt{k}]\n",
    "HOMEPAGE\n  $URL\n",
    "END\n";
  exit($errcode);
}
#......................................................................................
sub version { 
  say "$EXE $VERSION"; 
  exit(0); 
}
#......................................................................................
sub citation {
  say "Seemann T (2026), '$EXE' Github $URL";
  exit(0);
}
#......................................................................................
sub msg { print STDERR "@_\n" unless $opt{'q'}; }
sub wrn { msg("WARNING:", @_); }
sub err { print STDERR "ERROR: @_\n"; exit(-1); }
#......................................................................................
getopts('vhqCk:', \%opt) or exit(-1);
$opt{'v'} and version();
$opt{'C'} and citation();
$opt{'h'} and usage(0);
@ARGV or usage(1);
#......................................................................................
msg("This is $EXE $VERSION");
#msg("Loaded",0+@SIGPEP,"models, max length $SIGMAX");

my $seqs = load_fasta(\*ARGV);
@$seqs or err("No sequences foind in input");
  
for my $seq (@$seqs) {
  next if length($seq->[1]) > 500_000;
#  msg("Processing:", $seq->[0], 
#    "-", length($seq->[1]), "bp");
  trim_seq($seq);
}

msg("Done.");
exit(0);

#......................................................................................
sub trim_seq {
  my($seq) = @_;
  my %pos;
  my %delta;
  my $dna = uc( $seq->[1] );
#  $dna .= revcom($dna);
  my $L = length($dna);
  my $K = $opt{'k'};

  for my $i (0 .. $L-1-$K) {
    my $kmer = substr($dna,$i,$K);
    if (my $j = $pos{$kmer}) {
      $delta{ $i-$j }++;
    }
    $pos{$kmer} = $i;
  }
  my($mode) = sort 
    { $delta{$b} <=> $delta{$a} } keys %delta;
 
  if ($mode) { 
    msg("Trim",$seq->[0],"from $L to $mode",
      "delta=$delta{$mode}"
    );
  }
  
  print STDERR Dumper(\%delta),"\n"; 
}

#......................................................................................
sub revcom {
  my($s) = @_;
  $s =~ tr/ATCG/TAGC/;
  $s = reverse($s);
  return $s;
}

#......................................................................................
sub load_fasta {
  my($fh) = @_;
  my @seq;
  while (<$fh>) {
    chomp;
    if (m/^\s*>(\S+)/) {
      push @seq, [ $1, '' ];
    }
    else {
      @seq or err("Error parsing FASTA");
      $seq[-1]->[1] .= uc($_);
    }
  }
  msg("Loaded", 0+@seq, "sequences.");
  return \@seq;
}
#......................................................................................
